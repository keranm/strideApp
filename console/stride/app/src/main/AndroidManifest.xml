<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- A treadmill is switched off at the wall. Coming back to the console
         after a power cycle is the normal case, not a recovery case — see
         BootReceiver. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Bluetooth heart rate straps.

         Not required: the console runs fine without Bluetooth hardware, it
         just has no heart rate unless the machine wires contact grips into the
         board's pulse field. Many, including the one this was built on, do not.

         ACCESS_COARSE_LOCATION is the one that surprises people. A BLE scan can
         be used to infer position from nearby beacons, so from API 23 to 30 the
         platform requires a location permission to perform one — and without it
         the scan does not fail, it succeeds and returns nothing, which is a
         miserable thing to debug. This app targets SDK 28, so that is the rule
         that applies here and the permission has to be granted at runtime.

         BLUETOOTH_SCAN / BLUETOOTH_CONNECT / BLUETOOTH_ADVERTISE replaced them
         in API 31 and are declared for the day targetSdk moves. `neverForLocation`
         states what is already true — the scan filters on the heart rate service
         UUID and the results are used for nothing but pairing a strap.

         No maxSdkVersion on the legacy three. While targetSdk is 28, an API 31+
         console grants the new Bluetooth permissions *by way of* the legacy
         ones — capping those at 30 meant a Gen 7 console on Android 13 granted
         nothing, and FTMS advertising threw a SecurityException that took the
         whole app down with it. Cap them when targetSdk reaches 31, not before. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" tools:targetApi="31" />
    <!-- Display over other apps. Not used to draw over anything: on Android 10+
         it is what lets BootReceiver open the console at power-on, which is
         otherwise blocked as a background activity start (seen on a Gen 7,
         Android 13). Granted by tools/unchain.sh with appops, revocable in
         Settings → Apps → Special app access. The Android launcher stays the
         home app, so the rest of the console — streaming apps included —
         stays reachable. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- targetSdk 28 blocks cleartext by default, which would stop MediaPlayer
         fetching the coach's synthesised audio from Home Assistant. It has to be
         plain HTTP: the console's clock reads 2022, so TLS validation fails on
         anything served over HTTPS. The URL never leaves the LAN. -->
    <application
        android:label="STRIDE"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:theme="@style/Stride">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- Kiosk mode, off until asked for.

             Enabling this alias makes STRIDE the console's home app, so it
             comes back not just after a reboot but after being dismissed or
             killed. It is disabled in the manifest on purpose: two home apps
             and no preference between them means Android asks "which one?" at
             every boot, which is a worse first experience than the launcher
             it replaces. `tools/unchain.sh` turns it on and sets the
             preference in the same breath, which is the only order that is
             ever right. See that script for the two commands that enable it,
             and for the one that hands the console back to its launcher. -->
        <activity-alias
            android:name=".HomeAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Android 13 will not let adb enable the alias above, so the app does
             it on adb's behalf. DUMP: held by the shell, unobtainable by any
             installed app. See KioskReceiver. -->
        <receiver
            android:name=".KioskReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.stride.hud.KIOSK" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- MediaTek's quick-boot path sends this one instead. -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
